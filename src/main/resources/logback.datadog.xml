<configuration>
    <appender name="JSON_TCP" class="net.logstash.logback.appender.LogstashTcpSocketAppender">
        <destination>${ARCANE_DATADOG_ENDPOINT:-tcp-intake.logs.datadoghq.eu:443}</destination>
        <keepAliveDuration>20 seconds</keepAliveDuration>
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <includeMdc>true</includeMdc>
            <!-- ZIO log annotations arrive as SLF4J key-value pairs rather than MDC entries, so this is what
                 puts `http-path`, `http-method`, `client-ip` and `correlation-id` into the JSON sent to DataDog
                 and makes a request filterable by endpoint there. -->
            <includeKeyValuePairs>true</includeKeyValuePairs>
            <customFields>
                {
                "service":"arcane-push-stream",
                "ddsource":"java",
                "env":"${ENVIRONMENT:-unknown}",
                "version":"${APPLICATION_VERSION:-unknown}",
                "host":"${HOSTNAME}"
                }
            </customFields>
            <prefix class="ch.qos.logback.core.encoder.LayoutWrappingEncoder">
                <layout class="ch.qos.logback.classic.PatternLayout">
                    <pattern>${DD_API_KEY} %mdc{keyThatDoesNotExist}</pattern>
                </layout>
            </prefix>
        </encoder>
        <ssl />
    </appender>

    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <layout>
            <Pattern>%d [%thread] %-5level %logger{35} - %msg %kvp%n</Pattern>
        </layout>
    </appender>

    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="JSON_TCP" />
        <appender-ref ref="STDOUT" />
    </root>

    <!-- Keep noisy third-party libraries quiet (AWS SDK/Netty wire dumps, sttp watch logs). -->
    <logger name="software.amazon.awssdk" level="WARN" />
    <logger name="io.netty" level="WARN" />
    <logger name="sttp.client3.logging" level="WARN" />

</configuration>
